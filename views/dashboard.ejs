<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link rel="stylesheet" href="/styles/dashboard.css">
</head>
<body>
    <div class="layout">
        <aside class="sidebar">
            <div class="bot-icon-container">
                <img src="/images/bot-profile.webp" alt="Bot Icon" class="bot-icon">
            </div>
            <h2>Menu</h2>
            <ul>
                <li>
                    <div class="sidebar-option">
                        <a href="/home">🏠 Home</a>
                    </div>
                </li>
                <li>
                    <div class="sidebar-option">
                        <a href="/dashboard">📊 Dashboard</a>
                    </div>
                </li>
                <li>
                    <div class="sidebar-option">
                        <a href="/minigame">🎮 Minigame</a>
                    </div>
                </li>
                <li>
                    <div class="sidebar-option">
                        <a href="/servers">🌐 Servidores</a>
                    </div>
                </li>
                <li>
                    <div class="sidebar-option">
                        <a href="/logout">🚪 Sair</a>
                    </div>
                </li>
            </ul>
        </aside>
        <main class="main-content scrollable-content">
            <header class="header">
                <div class="welcome-container">
                    <h1>Dashboard</h1>
                </div>
            </header>
            <section class="content">
                <div class="wrapper">
                    <div class="stats grid">
                        <div class="container" title="Estatísticas do Bot">
                            <div class="title-container">
                                <h3>Estatísticas</h3>
                            </div>
                            <p><strong>Usuários Monitorados:</strong> <span id="monitoredUsers"><%= monitoredUsers %></span></p>
                            <p><strong>Servidores:</strong> <span id="serverCount"><%= serverCount %></span></p>
                        </div>
                        <div class="container" title="Atividade do Bot">
                            <div class="title-container">
                                <h3>Atividade</h3>
                            </div>
                            <p><strong>Comandos Executados:</strong> <span id="commandsExecuted"><%= commandsExecuted %></span></p>
                            <p><strong>Mensagens Processadas:</strong> <span id="messagesProcessed"><%= messagesProcessed %></span></p>
                        </div>
                    </div>
                    <div class="console-container">
                        <div class="title-container">
                            <h3>Console</h3>
                        </div>
                        <div id="console" class="console"></div>
                    </div>
                </div>
            </section>
        </main>
    </div>
    <script>
        function updateDashboardStats() {
            fetch('/api/dashboard')
                .then(response => response.json())
                .then(data => {
                    document.getElementById('monitoredUsers').textContent = data.monitoredUsers;
                    document.getElementById('serverCount').textContent = data.serverCount;
                    document.getElementById('commandsExecuted').textContent = data.commandsExecuted;
                    document.getElementById('messagesProcessed').textContent = data.messagesProcessed;
                })
                .catch(error => console.error('Error fetching dashboard stats:', error));
        }
    
        function loadLogHistory() {
            fetch('/api/logs')
                .then(response => response.json())
                .then(data => {
                    const consoleDiv = document.getElementById('console');
                    consoleDiv.innerHTML = ''; // limpa o conteúdo anterior
    
                    const lines = data.log.split('\n');
                    lines.forEach(line => {
                        if (line.trim() !== '') {
                            const logMessage = document.createElement('div');
                            logMessage.textContent = line;
                            consoleDiv.appendChild(logMessage);
                        }
                    });
    
                    consoleDiv.scrollTop = consoleDiv.scrollHeight;
                })
                .catch(error => console.error('Erro ao carregar histórico de logs:', error));
        }
    
        // Fetch stats and log history on page load
        updateDashboardStats();
        loadLogHistory();
    
        // Update stats every 5 minutes (300,000 milliseconds)
        setInterval(updateDashboardStats, 300000);
    
        // WebSocket to receive live logs
        const wsProtocol = window.location.protocol === 'https:' ? 'wss' : 'ws';
        const ws = new WebSocket(`${wsProtocol}://${window.location.host}`);
    
        ws.onmessage = (event) => {
            const consoleDiv = document.getElementById('console');
            const logMessage = document.createElement('div');
            logMessage.textContent = event.data;
            consoleDiv.appendChild(logMessage);
    
            if (consoleDiv.children.length > 500) {
                consoleDiv.removeChild(consoleDiv.firstChild); // Limita a 500 mensagens
            }
    
            consoleDiv.scrollTop = consoleDiv.scrollHeight;
        };
    </script>
</body>
</html>
