<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <link rel="stylesheet" href="/styles/home.css">
</head>
<body>
    <div class="layout">
        <aside class="sidebar">
            <div class="bot-icon-container">
                <img src="/images/bot-profile.webp" alt="Bot Icon" class="bot-icon">
            </div>
            <h2>Menu</h2>
            <ul>
                <li>
                    <div class="sidebar-option">
                        <a href="/home">🏠 Home</a>
                    </div>
                </li>
                <li>
                    <div class="sidebar-option">
                        <a href="/dashboard">📊 Dashboard</a>
                    </div>
                </li>
                <li>
                    <div class="sidebar-option">
                        <a href="/minigame">🎮 Minigame</a>
                    </div>
                </li>
                <li>
                    <div class="sidebar-option">
                        <a href="/servers">🌐 Servidores</a>
                    </div>
                </li>
                <li>
                    <div class="sidebar-option">
                        <a href="/logout">🚪 Sair</a>
                    </div>
                </li>
            </ul>
        </aside>
        <main class="main-content">
            <header class="header">
                <div class="welcome-container">
                    <h1>Bem-vindo(a), Haruka Harano</h1>
                </div>
            </header>
            <section class="content">
                <div class="commands-container">
                    <div class="title-container" onclick="toggleCommands()">
                        <h3>Comandos Carregados</h3>
                    </div>
                    <ul class="commands-list" id="commands-list"></ul>
                </div>
            </section>
            <script>
                function toggleCommands() {
                    const commandsList = document.getElementById('commands-list');
                    if (commandsList.style.maxHeight) {
                        commandsList.style.maxHeight = null; // Retract the list
                    } else {
                        if (!commandsList.hasChildNodes()) {
                            fetch('/api/commands')
                                .then(response => response.json())
                                .then(data => {
                                    commandsList.innerHTML = data.commands.map(command => `
                                        <li class="command-item">
                                            <strong>${command.name}</strong> = ${command.description}
                                        </li>
                                    `).join('');
                                    commandsList.style.maxHeight = commandsList.scrollHeight + "px"; // Expand the list
                                })
                                .catch(error => console.error('Error fetching commands:', error));
                        } else {
                            commandsList.style.maxHeight = commandsList.scrollHeight + "px"; // Expand the list
                        }
                    }
                }
            </script>
        </main>
    </div>
</body>
</html>
