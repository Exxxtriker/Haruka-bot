<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
    <link rel="stylesheet" href="/styles/home.css">
</head>
<body>
    <div class="layout">
        <aside class="sidebar">
            <div class="bot-icon-container">
                <img src="/images/bot-profile.webp" alt="Bot Icon" class="bot-icon">
            </div>
            <h2>Menu</h2>
            <ul>
                <li>
                    <div class="sidebar-option">
                        <a href="/home">🏠 Home</a>
                    </div>
                </li>
                <li>
                    <div class="sidebar-option">
                        <a href="/dashboard">📊 Dashboard</a>
                    </div>
                </li>
                <li>
                    <div class="sidebar-option">
                        <a href="/minigame">🎮 Minigame</a>
                    </div>
                </li>
                <li>
                    <div class="sidebar-option">
                        <a href="/servers">🌐 Servidores</a>
                    </div>
                </li>
                <li>
                    <div class="sidebar-option">
                        <a href="/logout">🚪 Sair</a>
                    </div>
                </li>
            </ul>
        </aside>
        <main class="main-content scrollable-content">
            <header class="header">
                <div class="welcome-container">
                    <h1>Bem-vindo(a)<% if (typeof username !== 'undefined' && username) { %>, <%= username %><% } %>!</h1>
                </div>
            </header>
            <section class="content">
                <!-- Bot Profile Container -->
                <div class="bot-profile-container">
                    <div class="title-container">
                        <h3>Perfil do Bot</h3>
                    </div>
                    <div class="bot-profile-content">
                        <img id="bot-avatar" alt="Bot Avatar" class="bot-avatar">
                        <div class="bot-details">
                            <p><strong>Nome:</strong> <span id="bot-name"></span></p>
                            <p><strong>ID:</strong> <span id="bot-id"></span></p>
                            <p><strong>Servidores:</strong> <span id="bot-servers"></span></p>
                            <p><strong>Usuários Monitorados:</strong> <span id="bot-users"></span></p>
                            <p><strong>Ping:</strong> <span id="bot-ping"></span> ms</p>
                            <p><strong>Data de Criação:</strong> <span id="bot-created"></span></p>
                            <p><strong>Tempo de Atividade:</strong> <span id="bot-uptime"></span></p>
                            <p><strong>Uso de Memória:</strong> <span id="bot-memory"></span></p>
                        </div>
                    </div>
                </div>
                <div class="commands-container">
                    <div class="title-container" onclick="toggleCommands()">
                        <h3>Comandos Carregados</h3>
                    </div>
                    <ul class="commands-list" id="commands-list"></ul>
                </div>
            </section>
            <script>
                function toggleCommands() {
                    const commandsList = document.getElementById('commands-list');
                    if (commandsList.style.maxHeight) {
                        commandsList.style.maxHeight = null; // Retract the list
                    } else {
                        if (!commandsList.hasChildNodes()) {
                            fetch('/api/commands')
                                .then(response => response.json())
                                .then(data => {
                                    commandsList.innerHTML = data.commands.map(command => `
                                        <li class="command-item">
                                            <strong>${command.name}</strong> = ${command.description}
                                        </li>
                                    `).join('');
                                    commandsList.style.maxHeight = commandsList.scrollHeight + "px"; // Expand the list
                                })
                                .catch(error => console.error('Error fetching commands:', error));
                        } else {
                            commandsList.style.maxHeight = commandsList.scrollHeight + "px"; // Expand the list
                        }
                    }
                }

                // Atualização automática dos dados do bot
                function updateBotProfile() {
                    fetch('/api/bot-profile')
                        .then(response => response.json())
                        .then(data => {
                            document.getElementById('bot-avatar').src = data.avatarURL || '/images/default-bot-icon.png';
                            document.getElementById('bot-name').textContent = data.name;
                            document.getElementById('bot-id').textContent = data.id;
                            document.getElementById('bot-servers').textContent = data.servers;
                            document.getElementById('bot-users').textContent = data.users;
                            document.getElementById('bot-ping').textContent = data.ping;
                            document.getElementById('bot-created').textContent = data.createdAt;
                            document.getElementById('bot-uptime').textContent = data.uptime;
                            document.getElementById('bot-memory').textContent = data.memoryUsage;
                        })
                        .catch(error => console.error('Error fetching bot profile:', error));
                }

                // Atualiza imediatamente e depois a cada 5 segundos
                updateBotProfile();
                setInterval(updateBotProfile, 5000);
            </script>
        </main>
    </div>
</body>
</html>
