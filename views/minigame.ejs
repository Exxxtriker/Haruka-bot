<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Minigame</title>
    <link rel="stylesheet" href="/styles/minigame.css">
</head>
<body>
    <div class="layout">
        <aside class="sidebar">
            <div class="bot-icon-container">
                <img src="/images/bot-profile.webp" alt="Bot Icon" class="bot-icon">
            </div>
            <h2>Menu</h2>
            <ul>
                <li>
                    <div class="sidebar-option">
                        <a href="/home">🏠 Home</a>
                    </div>
                </li>
                <li>
                    <div class="sidebar-option">
                        <a href="/dashboard">📊 Dashboard</a>
                    </div>
                </li>
                <li>
                    <div class="sidebar-option">
                        <a href="/minigame">🎮 Minigame</a>
                    </div>
                </li>
                <li>
                    <div class="sidebar-option">
                        <a href="/servers">🌐 Servidores</a>
                    </div>
                </li>
                <li>
                    <div class="sidebar-option">
                        <a href="/logout">🚪 Sair</a>
                    </div>
                </li>
            </ul>
        </aside>
        <main class="main-content scrollable-content">
            <header class="header">
                <div class="welcome-container">
                    <h1>Minigame - Dados dos Jogadores</h1>
                    <a href="/minigame/excel" class="download-button">Baixar Excel</a>
                </div>
            </header>
            <section class="content">
                <div class="players-container">
                    <% players.forEach(player => { %>
                        <div class="player-card">
                            <div class="player-header" onclick="toggleInventory('<%= player.displayName %>')">
                                <img src="<%= player.avatarURL %>" alt="Avatar" class="player-avatar">
                                <span class="player-name"><%= player.displayName %></span>
                            </div>
                            <div class="player-inventory" id="inventory-<%= player.displayName %>">
                                <div class="item-container">
                                    <span class="item-name">Coins</span>
                                    <span class="item-quantity"><%= player.coins %></span>
                                </div>
                                <% Object.entries(player.inventory).forEach(([item, quantity]) => { %>
                                    <div class="item-container">
                                        <span class="item-name"><%= item %></span>
                                        <span class="item-quantity"><%= quantity %></span>
                                    </div>
                                <% }); %>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </section>
            <script>
                function toggleInventory(playerName) {
                    const inventory = document.getElementById(`inventory-${playerName}`);
                    inventory.style.display = inventory.style.display === 'none' ? 'block' : 'none';
                }
            </script>
        </main>
    </div>
</body>
</html>
